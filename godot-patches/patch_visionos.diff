 elseif (_accesskit_os STREQUAL "linux")
@@ -31,9 +31,9 @@ if (_accesskit_os STREQUAL "windows")
         TARGET accesskit-shared
         PROPERTY IMPORTED_IMPLIB "${_accesskit_implib}"
     )
 endif()
