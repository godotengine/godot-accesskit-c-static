diff --git a/accesskit-config.cmake b/accesskit-config.cmake
index 938161c..edbe8f2 100644
--- a/accesskit-c/accesskit-config.cmake
+++ b/accesskit-c/accesskit-config.cmake
@@ -13,9 +13,9 @@ set_property(
     PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${ACCESSKIT_INCLUDE_DIR}"
 )
 if (_accesskit_os STREQUAL "macos")
     target_link_libraries(accesskit-static INTERFACE "-framework AppKit" "-framework Foundation" "-framework CoreFoundation" objc c++)
-elseif (_accesskit_os STREQUAL "ios" OR _accesskit_os STREQUAL "ios-simulator")
