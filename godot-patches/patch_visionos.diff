     set(_accesskit_shared_lib "libaccesskit.dylib")
 elseif (_accesskit_os STREQUAL "android" OR _accesskit_os STREQUAL "linux")
     set(_accesskit_shared_lib "libaccesskit.so")
 elseif (_accesskit_os STREQUAL "windows")
diff --git a/accesskit.cmake b/accesskit.cmake
index 81d468a..37086db 100644
--- a/accesskit-c/accesskit.cmake
+++ b/accesskit-c/accesskit.cmake
@@ -9,8 +9,16 @@ if (APPLE)
         else()
             set(_accesskit_os "ios")
         endif()
         unset(_accesskit_sysroot)
+    elseif (CMAKE_SYSTEM_NAME STREQUAL "visionOS")
+        string(TOLOWER "${CMAKE_OSX_SYSROOT}" _accesskit_sysroot)
+        if (_accesskit_sysroot MATCHES "xrsimulator")
+            set(_accesskit_os "visionos-simulator")
+        else()
+            set(_accesskit_os "visionos")
+        endif()
+        unset(_accesskit_sysroot)
     else()
         set(_accesskit_os "macos")
     endif()
     if (CMAKE_OSX_ARCHITECTURES MATCHES "(ARM64|arm64|aarch64)")
